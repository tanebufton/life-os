# Copy to .env and fill in. Nothing here is committed.

# ---- Required for the Cloudflare tunnel (Zero Trust -> Networks -> Tunnels -> create -> copy the token)
CLOUDFLARE_TUNNEL_TOKEN=
# The public address you'll use, e.g. https://life.example.com
LIFEOS_BASE_URL=

# ---- Cloudflare Access (strongly recommended). Zero Trust -> Access -> Applications -> your app -> Application Audience (AUD) tag
LIFEOS_CF_TEAM_DOMAIN=
LIFEOS_CF_AUD=
# The one email allowed in. Recommended if one Access application covers several sites (they share an AUD tag, so Cloudflare alone would let everyone on its policy in).
LIFEOS_ADMIN_EMAIL=
# Set to 1 to refuse every request unless the Access settings above are present (so a missing setting can never leave the app open).
LIFEOS_FAIL_CLOSED=

# ---- Optional
# Download the image GitHub builds on every push instead of building it here (./update.sh). Needs `docker login ghcr.io` once; see docs/DEPLOY.md → Updating.
# LIFEOS_REGISTRY_IMAGE=ghcr.io/<your github user, lower case>/life-os
TZ=Pacific/Auckland
# MCP server token (required if you run the mcp profile): openssl rand -hex 24
LIFEOS_MCP_TOKEN=
# AI assistant (also switch it on in Settings)
ANTHROPIC_API_KEY=
# Telegram bot (or paste the token in Settings)
TELEGRAM_BOT_TOKEN=
# Backups to Cloudflare R2 can be set in Settings, or here (these win over Settings; handy for restoring on a new machine)
LIFEOS_BACKUP_ENDPOINT=
LIFEOS_BACKUP_BUCKET=
LIFEOS_BACKUP_KEY_ID=
LIFEOS_BACKUP_SECRET=
LIFEOS_BACKUP_PASSPHRASE=
