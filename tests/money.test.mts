import assert from "node:assert/strict";
const L = (p: string) => import("../src/lib/" + p);
const C = await L("csv"), F = await L("moneyfmt"), M = await L("money"), S = await L("subs"), { today } = await L("time"), { addDays, addMonths } = await L("dates"), ST = await L("settings");
let n = 0; const ok = (m: string) => { n++; console.log("  ✓", m); };
const t = today(), month = t.slice(0, 7);

// ---- csv + bank formats
assert.deepEqual(C.parseCsv('a,b\n"x, y",2\n'), [["a", "b"], ["x, y", "2"]]); assert.deepEqual(C.parseCsv("a;b\n1;2"), [["a", "b"], ["1", "2"]]); ok("csv: quotes, commas, ; delimiter");
assert.equal(C.parseAmount("$1,234.56"), 123456); assert.equal(C.parseAmount("(12.30)"), -1230); assert.equal(C.parseAmount("-5"), -500); assert.equal(C.parseAmount("1.234,56"), 123456); assert.equal(C.parseAmount("12.30 DR"), -1230); assert.equal(C.parseAmount("abc"), null); ok("amount: symbols, parens, EU format, DR/CR");
assert.equal(C.parseDate("31/12/2026", true), "2026-12-31"); assert.equal(C.parseDate("12/31/2026", false), "2026-12-31"); assert.equal(C.parseDate("12/31/2026", true), "2026-12-31"); assert.equal(C.parseDate("5 Mar 2026"), "2026-03-05"); assert.equal(C.parseDate("Mar 5, 2026"), "2026-03-05"); assert.equal(C.parseDate("2026-02-30"), null); ok("date: DD/MM, MM/DD (auto-swap), named months, invalid");
let r = C.mapBankCsv("Date,Description,Debit,Credit,Balance\n02/03/2026,COUNTDOWN METRO,45.20,,900\n03/03/2026,SALARY ACME,,3000.00,3900\nbad,row,,,\n"); assert.equal(r.rows.length, 2); assert.equal(r.skipped, 1); assert.equal(r.rows[0].amount_cents, -4520); assert.equal(r.rows[1].amount_cents, 300000); ok("bank csv: debit/credit columns");
r = C.mapBankCsv("Transaction Date,Details,Amount\n2026-03-02,Netflix,-15.99\n2026-03-03,Refund,15.99\n"); assert.equal(r.rows[0].amount_cents, -1599); assert.equal(r.rows[1].amount_cents, 1599); r = C.mapBankCsv("Date,Merchant,Amount\n2026-03-02,Cafe,4.50\n", { invert: true }); assert.equal(r.rows[0].amount_cents, -450); ok("bank csv: single amount column, invert for cards");
assert.equal(C.mapBankCsv("foo,bar\n1,2").rows.length, 0); ok("bank csv: unrecognised columns yield nothing, not garbage");

// ---- formatting + $ quick add
assert.equal(F.fmtMoney(123456, "USD"), "$1,234.56"); assert.equal(F.fmtMoney(-500, "NZD"), "−NZ$5.00"); assert.equal(F.fmtMoney(1000, "USD", { sign: true }), "+$10.00"); ok("fmtMoney");
const cats = ["Eating out", "Groceries", "Salary"];
let q = F.parseMoneyQuick("$12.50 flat white @eating-out", t, cats); assert.deepEqual([q.amount_cents, q.payee, q.category], [-1250, "flat white", "Eating out"]);
q = F.parseMoneyQuick("spent 80 power yesterday #groc", t, cats); assert.equal(q.amount_cents, -8000); assert.equal(q.date, addDays(t, -1)); assert.equal(q.category, "Groceries"); assert.equal(q.payee, "power");
q = F.parseMoneyQuick("+$2,000 salary", t, cats); assert.equal(q.amount_cents, 200000); assert.equal(F.parseMoneyQuick("5 minute stretch", t, cats), null); assert.equal(F.parseMoneyQuick("Call mum", t, cats), null); ok("quick add: $ / spent / income / date / category, plain tasks ignored");

// ---- categories, budgets, transactions, rules
M.addStarterCategories(); const groc = M.categoryByName("groceries"), eat = M.categoryByName("eating-out"), sal = M.categoryByName("salary"); assert.ok(groc && eat && sal); assert.equal(M.categoryByName("zzz"), null); assert.ok(M.categoryByName("Pets", true)); ok("categories: starters, lookup, create-on-demand");
M.setBudget(groc, month, 50000, true); M.setBudget(eat, month, 20000, true); assert.equal(M.budgetFor(M.getCategory(groc), month), 50000);
M.setBudget(groc, month, 60000); assert.equal(M.budgetFor(M.getCategory(groc), month), 60000); assert.equal(M.budgetFor(M.getCategory(groc), M.shiftMonth(month, 1)), 50000); M.setBudget(groc, month, 50000); assert.equal(M.budgetFor(M.getCategory(groc), month), 50000); ok("budgets: default, per-month override, override cleared when equal");
M.addRule("countdown", groc); M.addRule("coffee", eat);
const t1 = M.addTransaction({ date: `${month}-02`, amount_cents: -4520, payee: "COUNTDOWN METRO" }); assert.equal(M.listTransactions({ month })[0].category_name, "Groceries"); ok("rules: auto-categorise by payee substring");
M.addTransaction({ date: `${month}-03`, amount_cents: -45000, payee: "Weekly shop", category_id: groc }); M.addTransaction({ date: `${month}-04`, amount_cents: -16000, payee: "Coffee Supreme", category_id: eat }); M.addTransaction({ date: `${month}-05`, amount_cents: 300000, payee: "ACME payroll", category_id: sal }); M.addTransaction({ date: `${month}-06`, amount_cents: -999, payee: "mystery" });
let sm = M.monthSummary(month, `${month}-10`); const g = sm.rows.find((x: any) => x.category.id === groc), e = sm.rows.find((x: any) => x.category.id === eat);
assert.equal(g.spent, 49520); assert.equal(g.pct, 99); assert.equal(e.pct, 80); assert.equal(sm.income_cents, 300000); assert.equal(sm.spent_cents, 49520 + 16000 + 999); assert.equal(sm.uncategorized_cents, -999); ok("summary: spent/pct per category, income, uncategorised counted in total");
assert.equal(sm.projected_cents, Math.round((sm.spent_cents / 10) * sm.daysInMonth)); ok("summary: month-end projection from the day-of-month pace");
const al = M.budgetAlerts(month); assert.ok(al.some((a: any) => a.category.id === groc && a.level === 80) && al.some((a: any) => a.category.id === eat && a.level === 80)); M.addTransaction({ date: `${month}-07`, amount_cents: -1000, payee: "x", category_id: groc }); assert.ok(M.budgetAlerts(month).some((a: any) => a.category.id === groc && a.level === 100)); ok("alerts: 80% then 100% thresholds");
assert.throws(() => M.addTransaction({ amount_cents: 0 })); assert.throws(() => M.addTransaction({ amount_cents: -5, date: "nope" })); ok("transactions: zero amount and bad date rejected");
assert.equal(M.addTransaction({ date: `${month}-08`, amount_cents: -100, payee: "dup", hash: "h1" }) !== null, true); assert.equal(M.addTransaction({ date: `${month}-08`, amount_cents: -100, payee: "dup", hash: "h1" }), null); ok("transactions: unique hash blocks duplicates");
const imp = M.importRows([{ date: `${month}-09`, amount_cents: -300, payee: "Coffee Supreme" }, { date: `${month}-09`, amount_cents: -300, payee: "Coffee Supreme" }]); assert.deepEqual(imp, { imported: 2, duplicates: 0 }); const again = M.importRows([{ date: `${month}-09`, amount_cents: -300, payee: "Coffee Supreme" }, { date: `${month}-09`, amount_cents: -300, payee: "Coffee Supreme" }]); assert.deepEqual(again, { imported: 0, duplicates: 2 });
ok("import: two identical same-day purchases both kept, re-import fully de-duplicated");
M.updateTransaction(t1, { category_id: null }); assert.equal(M.applyRulesToUncategorized() >= 1, true); ok("rules applied retroactively to uncategorised");
const tr = M.spendTrend(3, `${month}-10`); assert.equal(tr.length, 3); assert.ok(tr[2].spent > 0); assert.ok(M.topPayees(month)[0].total > 0); ok("trend + top payees");
const sv = M.createSaving("Holiday", 120000, addMonths(t, 6)); M.contributeSaving(sv, 20000); const s0 = M.listSavings()[0]; assert.equal(s0.saved_cents, 20000); assert.ok(M.savingNeeded(s0, t) >= 16000 && M.savingNeeded(s0, t) <= 20000); M.contributeSaving(sv, -999999); assert.equal(M.listSavings()[0].saved_cents, 0); ok("savings goals: contribute, monthly amount needed, floor at zero");

// ---- subscriptions
assert.equal(S.monthlyCents({ amount_cents: 1200, cycle: "yearly" }), 100); assert.equal(S.monthlyCents({ amount_cents: 300, cycle: "quarterly" }), 100); assert.equal(S.monthlyCents({ amount_cents: 1000, cycle: "weekly" }), 4333); assert.equal(S.stepDate("2026-01-31", "monthly"), "2026-02-28"); ok("subs: cycle maths + month-end clamp");
const nf = S.createSub({ name: "Netflix", amount_cents: 1599, next_due: addDays(t, -40) }), sp = S.createSub({ name: "Spotify", amount_cents: 1299, next_due: addDays(t, 2), remind_days: 3 }), ic = S.createSub({ name: "iCloud", amount_cents: 400, cycle: "yearly", next_due: addDays(t, 200) }), tri = S.createSub({ name: "TrialApp", amount_cents: 999, trial_ends: addDays(t, 1), next_due: addDays(t, 1) });
const logged = S.advanceSubscriptions(t); assert.ok(logged >= 2); const nfRow = S.getSub(nf); assert.ok(nfRow.next_due > t); assert.equal(M.listTransactions({ q: "Netflix", limit: 50 }).length, logged >= 2 ? M.listTransactions({ q: "Netflix", limit: 50 }).length : 0);
const before = M.listTransactions({ q: "Netflix", limit: 50 }).length; assert.equal(S.advanceSubscriptions(t), 0); assert.equal(M.listTransactions({ q: "Netflix", limit: 50 }).length, before); ok("subs: overdue cycles are logged once each and the date rolls forward (idempotent)");
assert.ok(M.listTransactions({ q: "Netflix" }).every((x: any) => x.amount_cents === -1599 && x.source === "subscription")); ok("subs: auto-logged transactions are expenses tagged source=subscription");
S.updateSub(sp, { amount_cents: 1499 }); assert.deepEqual(S.priceChange(sp), { from: 1299, to: 1499 }); S.updateSub(sp, { amount_cents: 1499 }); assert.equal(S.priceHistory(sp).length, 2); ok("subs: price rise recorded once");
const rem = S.subReminders(t); assert.ok(rem.some((x: any) => /Spotify renews in 2 days/.test(x.title))); assert.ok(rem.some((x: any) => /TrialApp trial ends tomorrow/.test(x.title))); assert.ok(!rem.some((x: any) => /iCloud/.test(x.title))); ok("subs: renewal + trial-ending reminders, far-off ones excluded");
S.setSubStatus(ic, "paused"); S.setSubStatus(nf, "cancelled"); const sum = S.subsSummary(t); assert.ok(!S.listSubs("active").some((x: any) => x.id === nf || x.id === ic)); assert.equal(sum.monthly_cents, S.monthlyCents({ amount_cents: 1499, cycle: "monthly" }) + S.monthlyCents({ amount_cents: 999, cycle: "monthly" })); assert.equal(sum.cancelled.length, 1); ok("subs: paused/cancelled excluded from the monthly total");
const mp = S.createSub({ name: "Manual", amount_cents: 500, next_due: t, auto_log: false }); assert.equal(S.advanceSubscriptions(t) >= 0, true); assert.equal(M.listTransactions({ q: "Manual" }).length, 0); S.markPaid(mp); assert.equal(M.listTransactions({ q: "Manual" }).length, 1); assert.ok(S.getSub(mp).next_due > t); ok("subs: auto-log off logs nothing until you mark it paid");
assert.throws(() => S.createSub({ name: "", amount_cents: 1 })); assert.throws(() => S.createSub({ name: "x", amount_cents: 1, cycle: "daily" as any })); ok("subs: validation");
console.log(`\n${n} checks passed`);
