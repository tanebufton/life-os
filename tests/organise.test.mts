import assert from "node:assert/strict";
const F = await import("../src/lib/favourites.ts"); const N = await import("../src/lib/notes.ts"); const T = await import("../src/lib/tasks.ts"); const { db } = await import("../src/lib/db.ts");
let n = 0; const ok = (m: string) => { n++; console.log("  ✓", m); };
const proj = Number(db.prepare("INSERT INTO projects (name, color, area, icon) VALUES ('Hub', '#123456', 'Work', '🚀')").run().lastInsertRowid);
assert.deepEqual(db.prepare("SELECT area, icon FROM projects WHERE id=?").get(proj), { area: "Work", icon: "🚀" }); ok("projects carry an area and an icon");
const root = N.createNote("Handbook", "x", proj), a = N.createNote("Setup", "y", null, root), b = N.createNote("Deploy", "z", null, a), other = N.createNote("Loose");
assert.equal(N.getNote(a)!.parent_id, root); assert.equal(N.getNote(a)!.project_id, proj); ok("a sub-page is created under its parent and joins its project");
assert.deepEqual(N.noteAncestors(b).map((x) => x.id), [root, a]); assert.deepEqual(N.noteChildren(root).map((x) => x.id), [a]); assert.deepEqual(N.noteDescendants(root).sort(), [a, b].sort()); ok("ancestors, children and descendants follow the tree");
assert.ok(N.moveNote(root, b)); assert.ok(N.moveNote(root, root)); assert.equal(N.getNote(root)!.parent_id, null); ok("a page can't be moved inside itself or its own sub-pages");
assert.equal(N.moveNote(other, a), null); assert.equal(N.getNote(other)!.parent_id, a); assert.equal(N.moveNote(other, null), null); ok("moving to another page and back to the top level works");
const flat = N.noteTree(N.listNotes({ project: proj })); assert.deepEqual(flat.map((x: any) => [x.id, x.depth]), [[root, 0], [a, 1], [b, 2]]); ok("the tree is ordered parents first with depth");
const sub = N.noteTree(N.listNotes({ ids: [b] })); assert.deepEqual(sub.map((x: any) => x.depth), [0]); ok("a filtered result whose parent isn't shown stays visible at the top");
N.deleteNote(a); assert.deepEqual(N.noteTree(N.listNotes({ project: proj })).map((x: any) => [x.id, x.depth]).sort(), [[b, 0], [root, 0]].sort()); ok("deleting a page doesn't hide its sub-pages");
const t = T.createTask({ title: "Ship it" });
assert.equal(F.toggleFavourite("task", t), true); assert.equal(F.toggleFavourite("note", root), true); assert.equal(F.toggleFavourite("project", proj), true);
assert.deepEqual(F.listFavourites().map((x: any) => x.kind), ["task", "note", "project"]); assert.equal(F.listFavourites()[2].icon, "🚀"); ok("favourites list in the order starred, with icons");
assert.equal(F.toggleFavourite("task", t), false); assert.equal(F.isFavourite("task", t), false); ok("starring again removes it");
N.deleteNote(root); db.prepare("UPDATE projects SET archived=1 WHERE id=?").run(proj); assert.equal(F.listFavourites().length, 0); ok("deleted notes and archived projects drop out of favourites");
console.log(`  ${n} checks`);
