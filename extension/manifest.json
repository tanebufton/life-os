{
  "manifest_version": 3,
  "name": "LifeOS Voice",
  "version": "1.0.0",
  "description": "Speak a thought and send it to your LifeOS as a task, note or memo, without opening it.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Record a voice memo to LifeOS" },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": { "record": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Record a voice memo" } }
}
